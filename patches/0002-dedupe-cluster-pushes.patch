@@ -0,0 +1,81 @@
+// MainThrive (patch 0002), through the real relay: a clustered mail server's copies of one push reach the push
+// service once, and a push the relay did not forward (held back, or refused by the push service) leaves no claim
+// behind, so the mail server's retry of it goes through instead of being taken for its own copy.
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import {
+  emailPush,
+  makeDevice,
+  newId,
+  postJson,
+  startFakePushService,
+  startRelay,
+  type FakePushService,
+  type RunningRelay,
+} from './test-support/harness.js';
+
+let service: FakePushService;
+let relay: RunningRelay;
+
+before(async () => {
+  service = await startFakePushService();
+  relay = await startRelay();
+});
+
+after(async () => {
+  await relay.stop();
+  await service.close();
+});
+
+async function registerWeb(pathname: string): Promise<string> {
+  const id = newId();
+  const res = await postJson(relay.base, '/api/push/register/web', {
+    subscriptionId: id,
+    subscription: { endpoint: service.url(pathname), keys: makeDevice().keys },
+    accountLabel: 'alice@example.org',
+  });
+  assert.equal(res.status, 200);
+  return id;
+}
+
+describe('one push per message from a clustered mail server', () => {
+  it('forwards two concurrent copies once, and the next message again', async () => {
+    const id = await registerWeb('/dedupe-copies');
+    const [a, b] = await Promise.all([
+      postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['e1'])),
+      postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['e1'])),
+    ]);
+    assert.deepEqual([a.status, b.status], [200, 200]);
+    assert.equal([a.body, b.body].filter((body) => body.duplicate === true).length, 1);
+    assert.equal(service.to('/dedupe-copies').length, 1);
+    assert.equal((await postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['e2']))).status, 200);
+    assert.equal(service.to('/dedupe-copies').length, 2);
+  });
+
+  it('leaves no claim for a push the push service refused, so its retry is forwarded', async () => {
+    const id = await registerWeb('/dedupe-refused');
+    service.answer('/dedupe-refused', { status: 500 });
+    const first = await postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['r1']));
+    assert.notEqual(first.body.duplicate, true);
+    service.answer('/dedupe-refused', { status: 201 });
+    const retry = await postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['r1']));
+    assert.equal(retry.status, 200);
+    assert.notEqual(retry.body.duplicate, true, 'the retry of a refused push was dropped as a copy');
+    assert.equal(service.to('/dedupe-refused').length, 2);
+  });
+
+  it('leaves no claim for a push held back, so its retry is forwarded once the hold ends', async () => {
+    const id = await registerWeb('/dedupe-held');
+    // The push service asks for a backoff; the relay then holds the next push for that endpoint.
+    service.answer('/dedupe-held', { status: 429, headers: { 'retry-after': '1' } });
+    assert.equal((await postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['h0']))).status, 503);
+    service.answer('/dedupe-held', { status: 201 });
+    const held = await postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['h1']));
+    assert.equal(held.status, 503);
+    assert.equal(held.body.held, 'push-service-backoff');
+    await new Promise((resolve) => setTimeout(resolve, 1500));
+    const retry = await postJson(relay.base, `/api/push/jmap/${id}`, emailPush('a', ['h1']));
+    assert.equal(retry.status, 200);
+    assert.notEqual(retry.body.duplicate, true, 'the retry of a held push was dropped as a copy');
+  });
+});
