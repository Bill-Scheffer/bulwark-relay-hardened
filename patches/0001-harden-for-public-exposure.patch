+// The push services browsers subscribe through: Chrome/Android and most
+// Chromium browsers (FCM), Firefox (Mozilla autopush), Safari and iOS
+// (Apple), Edge (WNS). A leading "." matches any subdomain. Overridable with
+// WEBPUSH_ALLOWED_HOSTS (comma-separated, same syntax).
+export const DEFAULT_WEBPUSH_HOSTS = [
+  'fcm.googleapis.com',
+  'updates.push.services.mozilla.com',
+  'web.push.apple.com',
+  '.notify.windows.com',
+];
+
+function allowedWebPushHosts(): string[] {
+  const configured = process.env.WEBPUSH_ALLOWED_HOSTS?.split(',')
+    .map((h) => h.trim().toLowerCase())
+    .filter(Boolean);
+  return configured?.length ? configured : DEFAULT_WEBPUSH_HOSTS;
+}
+
+// Without this, anyone can register an arbitrary https URL as their "push
+// service" and then, by POSTing to /api/push/jmap/:id with their own id, make
+// the relay send a request to it: server-side request forgery, from the
+// relay's network. Only endpoints on a known push service are accepted.
+export function isAllowedWebPushEndpoint(
+  endpoint: string,
+  allowed: string[] = allowedWebPushHosts(),
+): boolean {
+  let host: string;
+  try {
+    const url = new URL(endpoint);
+    if (url.protocol !== 'https:' || url.port !== '') return false;
+    host = url.hostname.toLowerCase();
+  } catch {
+    return false;
+  }
+  return allowed.some((entry) =>
+    entry.startsWith('.') ? host.endsWith(entry) && host.length > entry.length : host === entry,
+  );
+}
