+++ b/src/store.test.ts
@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict';
+import { mkdtempSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { describe, it } from 'node:test';
+
+process.env.PUSH_DATA_DIR = mkdtempSync(path.join(tmpdir(), 'relay-store-'));
+const { subscriptionStore } = await import('./store.js');
+
+const keys = { p256dh: 'B'.repeat(87), auth: 'a'.repeat(22) };
+function web(createdAt: number, jmapSeenAt: number | null) {
+  return {
+    kind: 'web' as const,
+    webPush: { endpoint: 'https://fcm.googleapis.com/fcm/send/x', keys },
+    verificationCode: null,
+    createdAt,
+    lastPushAt: null,
+    jmapSeenAt,
+  };
+}
+
+describe('prunePending', () => {
+  it('drops stale pending records, keeps fresh pending and every confirmed one', async () => {
+    const now = Date.now();
+    const hour = 60 * 60 * 1000;
+    await subscriptionStore.put('stale-pending', web(now - hour, null));
+    await subscriptionStore.put('fresh-pending', web(now - 1000, null));
+    await subscriptionStore.put('old-confirmed', web(now - 30 * 24 * hour, now - 29 * 24 * hour));
+
+    assert.equal(await subscriptionStore.prunePending(10 * 60 * 1000), 1);
+    assert.equal(await subscriptionStore.get('stale-pending'), null);
+    assert.notEqual(await subscriptionStore.get('fresh-pending'), null);
+    assert.notEqual(await subscriptionStore.get('old-confirmed'), null);
+  });
+});
