@@ -76,6 +76,28 @@ class SubscriptionStore {
     }
   }
 
+  /**
+   * Drops pending records (never reached by the JMAP server) older than
+   * maxAgeMs, and returns how many pending records remain.
+   */
+  async prunePending(maxAgeMs: number): Promise<number> {
+    await this.ensureLoaded();
+    const now = Date.now();
+    let pending = 0;
+    let evicted = false;
+    for (const [id, record] of Object.entries(this.cache)) {
+      if (record.jmapSeenAt != null) continue;
+      if (now - record.createdAt > maxAgeMs) {
+        delete this.cache[id];
+        evicted = true;
+      } else {
+        pending++;
+      }
+    }
+    if (evicted) await this.persist();
+    return pending;
+  }
+
   async size(): Promise<number> {
     await this.ensureLoaded();
     return Object.keys(this.cache).length;
